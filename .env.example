# ---------------------------------------------------------------------------
# Samadhan configuration. Copy to .env and fill in ONE free LLM key.
# Every setting maps to samadhan/config.py: SAMADHAN_<GROUP>__<FIELD>.
# ---------------------------------------------------------------------------

# --- LLM (pick one free provider) -------------------------------------------
# gemini: free key at https://aistudio.google.com/apikey
# groq:   free key at https://console.groq.com/keys  (also enables the Prompt Guard classifier)
# ollama: fully local, no key - install https://ollama.com and `ollama pull qwen3:8b qwen3:4b`
SAMADHAN_LLM__PROFILE=gemini
GOOGLE_API_KEY=
GROQ_API_KEY=
# Optional overrides of individual roles (any `provider:model` understood by init_chat_model):
# SAMADHAN_LLM__SMART_MODEL=google_genai:gemini-3.8-flash
# SAMADHAN_LLM__FAST_MODEL=groq:openai/gpt-oss-20b
# SAMADHAN_LLM__FALLBACK_MODELS=["groq:openai/gpt-oss-120b"]

# --- Retrieval ----------------------------------------------------------------
# qdrant (embedded on disk by default; set a URL for a server / Qdrant Cloud) or pgvector
SAMADHAN_RETRIEVAL__BACKEND=qdrant
# SAMADHAN_RETRIEVAL__QDRANT_URL=http://localhost:6333
# SAMADHAN_RETRIEVAL__QDRANT_API_KEY=

# --- Persistence (empty = local SQLite + in-memory store) --------------------
# SAMADHAN_PERSISTENCE__DATABASE_URL=postgresql://samadhan:samadhan@localhost:5432/samadhan

# --- Security (MUST change outside local dev; prod refuses to start otherwise) ---
# python -c "import secrets; print(secrets.token_hex(32))"
# Service-token keys (Ed25519) - run `uv run samadhan keys generate`. Unset in dev = auto-generated
# shared pair under .data/keys. In production: PUBLIC key for every service, PRIVATE key for the API
# only (prod overlay: put it in .env.api).
# SAMADHAN_MCP__JWT_PUBLIC_KEY=
# SAMADHAN_MCP__JWT_PRIVATE_KEY=
# Staff SSO (OIDC): any IdP - Keycloak, Auth0, Entra ID, Okta. Roles claim: supervisor / agent / admin.
# SAMADHAN_API__STAFF_OIDC_ISSUER=https://idp.example.com/realms/voltwise
# SAMADHAN_API__STAFF_OIDC_AUDIENCE=samadhan
# SAMADHAN_API__STAFF_OIDC_JWKS_URI=https://idp.example.com/realms/voltwise/protocol/openid-connect/certs
# SAMADHAN_API__ADMIN_KEY_ENABLED=false   # disable the break-glass staff key once SSO works
# SAMADHAN_API__TOKEN_SECRET=
# SAMADHAN_API__ADMIN_API_KEY=
SAMADHAN_API__DEMO_MODE=true

# --- Business rules ----------------------------------------------------------
SAMADHAN_AGENT__REFUND_AUTO_APPROVE_LIMIT=100
# Soft LLM spend budget per turn (USD at list prices) - breaches are logged + counted
# SAMADHAN_AGENT__TURN_BUDGET_USD=0.05
# Price overrides (USD per 1M tokens) for models not in samadhan/cost.py:
# SAMADHAN_OBSERVABILITY__PRICES='{"qwen3:8b": {"input": 0, "output": 0}}'

# --- Semantic answer cache (knowledge questions only) ---------------------------
# SAMADHAN_RETRIEVAL__SEMANTIC_CACHE=true
# SAMADHAN_RETRIEVAL__CACHE_CANDIDATE_THRESHOLD=0.80   # tuned with `samadhan eval cache`

# --- A2A (agent-to-agent) -------------------------------------------------------
# SAMADHAN_API__A2A_ENABLED=true
# SAMADHAN_API__PUBLIC_URL=https://support.example.com   # advertised in the agent card

# --- Observability (optional) -------------------------------------------------
# LangSmith (free developer tier):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# Langfuse (open source, self-hostable or free cloud tier) - `uv sync --extra observability`:
# SAMADHAN_OBSERVABILITY__LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# OpenTelemetry (vendor-neutral traces, GenAI semantic conventions) -> Jaeger / Tempo / any OTLP backend:
# SAMADHAN_OBSERVABILITY__OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- docker compose only -------------------------------------------------------
POSTGRES_PASSWORD=samadhan
# DOMAIN=support.example.com   (production overlay with automatic HTTPS)
