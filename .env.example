# ---------------------------------------------------------------------------
# CaseFlow configuration. Copy to .env and fill in ONE free LLM key.
# Every setting maps to caseflow/config.py: CASEFLOW_<GROUP>__<FIELD>.
# ---------------------------------------------------------------------------

# --- LLM (pick one free provider) -------------------------------------------
# gemini: free key at https://aistudio.google.com/apikey
# groq:   free key at https://console.groq.com/keys  (also enables the Prompt Guard classifier)
# ollama: fully local, no key - install https://ollama.com and `ollama pull qwen3:8b qwen3:4b`
CASEFLOW_LLM__PROFILE=gemini
GOOGLE_API_KEY=
GROQ_API_KEY=
# Optional overrides of individual roles (any `provider:model` understood by init_chat_model):
# CASEFLOW_LLM__SMART_MODEL=google_genai:gemini-3.8-flash
# CASEFLOW_LLM__FAST_MODEL=groq:openai/gpt-oss-20b
# CASEFLOW_LLM__FALLBACK_MODELS=["groq:openai/gpt-oss-120b"]

# --- Retrieval ----------------------------------------------------------------
# qdrant (embedded on disk by default; set a URL for a server / Qdrant Cloud) or pgvector
CASEFLOW_RETRIEVAL__BACKEND=qdrant
# CASEFLOW_RETRIEVAL__QDRANT_URL=http://localhost:6333
# CASEFLOW_RETRIEVAL__QDRANT_API_KEY=

# --- Persistence (empty = local SQLite + in-memory store) --------------------
# CASEFLOW_PERSISTENCE__DATABASE_URL=postgresql://caseflow:caseflow@localhost:5432/caseflow

# --- Security (MUST change outside local dev; prod refuses to start otherwise) ---
# python -c "import secrets; print(secrets.token_hex(32))"
# CASEFLOW_MCP__JWT_SECRET=
# CASEFLOW_API__TOKEN_SECRET=
# CASEFLOW_API__ADMIN_API_KEY=
CASEFLOW_API__DEMO_MODE=true

# --- Business rules ----------------------------------------------------------
CASEFLOW_AGENT__REFUND_AUTO_APPROVE_LIMIT=100
# Soft LLM spend budget per turn (USD at list prices) - breaches are logged + counted
# CASEFLOW_AGENT__TURN_BUDGET_USD=0.05
# Price overrides (USD per 1M tokens) for models not in caseflow/cost.py:
# CASEFLOW_OBSERVABILITY__PRICES='{"qwen3:8b": {"input": 0, "output": 0}}'

# --- Semantic answer cache (knowledge questions only) ---------------------------
# CASEFLOW_RETRIEVAL__SEMANTIC_CACHE=true
# CASEFLOW_RETRIEVAL__CACHE_CANDIDATE_THRESHOLD=0.80   # tuned with `caseflow eval cache`

# --- A2A (agent-to-agent) -------------------------------------------------------
# CASEFLOW_API__A2A_ENABLED=true
# CASEFLOW_API__PUBLIC_URL=https://support.example.com   # advertised in the agent card

# --- Observability (optional) -------------------------------------------------
# LangSmith (free developer tier):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# Langfuse (open source, self-hostable or free cloud tier) - `uv sync --extra observability`:
# CASEFLOW_OBSERVABILITY__LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# OpenTelemetry (vendor-neutral traces, GenAI semantic conventions) -> Jaeger / Tempo / any OTLP backend:
# CASEFLOW_OBSERVABILITY__OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- docker compose only -------------------------------------------------------
POSTGRES_PASSWORD=caseflow
# DOMAIN=support.example.com   (production overlay with automatic HTTPS)
